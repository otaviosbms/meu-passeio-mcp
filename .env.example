# Copie para .env e ajuste. Nunca versione o .env.

# Credencial do Claude (lida pelo SDK da Anthropic; nunca é enviada ao modelo nem logada)
ANTHROPIC_API_KEY=

# Aplicação
MEU_PASSEIO_LOG_LEVEL=INFO
# SQLite local (padrão) ou PostgreSQL:
# MEU_PASSEIO_DATABASE_URL=postgresql+asyncpg://meu_passeio:meu_passeio@localhost:5432/meu_passeio
MEU_PASSEIO_ENABLE_TOOL_DEBUG_ENDPOINT=true

# LLM
MEU_PASSEIO_LLM_MODEL=claude-opus-5-5
MEU_PASSEIO_LLM_EFFORT=medium
MEU_PASSEIO_LLM_ENABLE_FALLBACKS=true

# Limites do agente (controle de custo)
MEU_PASSEIO_PLANNER_MAX_TOOL_ITERATIONS=12
MEU_PASSEIO_PLANNER_MAX_TOOL_CALLS=30
MEU_PASSEIO_PLANNER_MAX_REVISIONS=1

# Provedores públicos usados pelos MCP Servers (opcionais)
# Recomenda-se um User-Agent com contato próprio, conforme a política do Nominatim/Overpass.
# MEU_PASSEIO_HTTP_USER_AGENT=meu-passeio/0.1 (contato@exemplo.com)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# OSRM_BASE_URL=https://routing.openstreetmap.de
